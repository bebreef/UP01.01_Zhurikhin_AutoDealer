<Window x:Class="WPF_Zhurikhin_AutoDealer.MainWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        Title="{Binding Content.Title, ElementName=MainFrame, StringFormat='АвтоДилер — {0}', FallbackValue=АвтоДилер}" 
        Height="760" 
        Width="1100" 
        MinHeight="550" 
        MinWidth="800" 
        WindowStartupLocation="CenterScreen" 
        FontFamily="Segoe UI" 
        Icon="/Images/logo.ico" 
        Closing="Window_Closing" 
        Background="{DynamicResource WindowBackgroundBrush}" 
        Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>
        <Border Padding="20,14" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="LogoutButton" Width="42" Height="42" Margin="0,0,12,0" DockPanel.Dock="Left" Visibility="Collapsed" ToolTip="Выйти из учётной записи" Click="LogoutButton_Click">
                    <Rectangle Width="22" Height="22" Fill="{DynamicResource ButtonTextBrush}">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="/Images/exit.png"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Button>
                <Button x:Name="BackButton" Content="Назад" Width="100" Height="42" Margin="0,0,12,0" DockPanel.Dock="Left" Visibility="Collapsed" Click="BackButton_Click" ToolTip="Вернуться на предыдущую страницу"/>
                <Button x:Name="ChangeTheme" Content="Сменить тему" Width="150" Height="42" Margin="12,0,0,0" DockPanel.Dock="Right" Click="ChangeTheme_Click" ToolTip="Переключить тему оформления"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="АвтоДилер" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Content.Title, ElementName=MainFrame}" FontSize="13" Opacity="0.7"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" ClipToBounds="True">
            <Frame x:Name="MainFrame" Margin="14,0,0,0" NavigationUIVisibility="Hidden" Navigating="MainFrame_Navigating" Navigated="MainFrame_Navigated" MouseEnter="MenuArea_MouseLeave"/>
            <Grid x:Name="MenuArea" Width="14" HorizontalAlignment="Left" ClipToBounds="True" Background="Transparent" Visibility="Collapsed" MouseEnter="MenuArea_MouseEnter" MouseLeave="MenuArea_MouseLeave">
                <Border Width="14" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" Opacity="0.35" ToolTip="Подведите мышь, чтобы открыть меню"/>
            <Border x:Name="Sidebar" Width="220" HorizontalAlignment="Left" Padding="8" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="0,0,1,0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="MenuTransform" X="-220"/>
                </Border.RenderTransform>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button x:Name="PasswordMenu" Tag="password" Height="44" Margin="0,0,0,8" Padding="10,0" HorizontalContentAlignment="Left" ToolTip="Сменить пароль" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="22" Height="22" Fill="{DynamicResource ButtonTextBrush}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Images/key.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Сменить пароль" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                        <Button x:Name="HomeMenu" Tag="home" Height="44" Margin="0,0,0,8" Padding="10,0" HorizontalContentAlignment="Left" ToolTip="Главная" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="22" Height="22" Fill="{DynamicResource ButtonTextBrush}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Images/house.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Главная" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CarsMenu" Tag="cars" Height="44" Margin="0,0,0,8" Padding="10,0" HorizontalContentAlignment="Left" ToolTip="Автомобили" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="22" Height="22" Fill="{DynamicResource ButtonTextBrush}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Images/car.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Автомобили" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ClientsMenu" Tag="clients" Height="44" Margin="0,0,0,8" Padding="10,0" HorizontalContentAlignment="Left" ToolTip="Клиенты" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="22" Height="22" Fill="{DynamicResource ButtonTextBrush}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Images/user.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Клиенты" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="DealsMenu" Tag="deals" Height="44" Margin="0,0,0,8" Padding="10,0" HorizontalContentAlignment="Left" ToolTip="Сделки" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="22" Height="22" Fill="{DynamicResource ButtonTextBrush}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Images/receipt.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Сделки" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="EmployeesMenu" Tag="employees" Height="44" Margin="0,0,0,8" Padding="10,0" HorizontalContentAlignment="Left" ToolTip="Сотрудники" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="22" Height="22" Fill="{DynamicResource ButtonTextBrush}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Images/badge.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Сотрудники" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ReportsMenu" Tag="reports" Height="44" Margin="0,0,0,8" Padding="10,0" HorizontalContentAlignment="Left" ToolTip="Отчёты" Click="NavigationButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="22" Height="22" Fill="{DynamicResource ButtonTextBrush}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="/Images/column-chart.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="Отчёты" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="0,1,0,0" Padding="20,0">
            <TextBlock x:Name="DateTimeText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13"/>
        </Border>
    </Grid>
</Window>
