<Window x:Class="WPF_Zhurikhin_AutoDealer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Zhurikhin_AutoDealer"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Background="{DynamicResource WindowBackgroundBrush  }">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button x:Name="BackButton" Grid.Row="0" HorizontalAlignment="Left" Margin="10" VerticalAlignment="Center" Click="BackButton_Click" Content="Назад" Visibility="Hidden"/>
        <Button x:Name="ChangeTheme" Grid.Row="0" HorizontalAlignment="Right" Margin="10" VerticalAlignment="Center" Click="ChangeTheme_Click" Content="Сменить тему"/>
        <Frame Margin="10" Grid.Row="1" x:Name="MainFrame" NavigationUIVisibility="Hidden" Navigated="MainFrame_Navigated"/>
    </Grid>
</Window>
