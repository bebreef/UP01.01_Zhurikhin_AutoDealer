<Page x:Class="WPF_Zhurikhin_AutoDealer.Pages.CarsPage" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      Title="Автомобили" 
      Loaded="Page_Loaded" 
      Background="{DynamicResource WindowBackgroundBrush}" 
      Foreground="{DynamicResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadingText" Text="Автомобили" FontSize="26" FontWeight="Bold" Margin="0,0,0,16"/>
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Width="240" Margin="0,0,12,8">
                <TextBlock Text="Поиск по VIN, марке или модели"/>
                <Grid>
                    <TextBox x:Name="SearchBox" Margin="0,6,0,0" MaxLength="100" ToolTip="Введите часть VIN, марки или модели" TextChanged="SearchBox_TextChanged"/>
                    <TextBlock Text="Начните вводить…" Margin="9,6,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.55">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
            <StackPanel Width="170" Margin="0,0,12,8">
                <TextBlock Text="Статус"/>
                <ComboBox x:Name="StatusBox" Margin="0,6,0,0" Height="36" VerticalContentAlignment="Center" ToolTip="Показать автомобили выбранного статуса" SelectionChanged="Filter_SelectionChanged"/>
            </StackPanel>
            <StackPanel Width="170" Margin="0,0,12,8">
                <TextBlock Text="Марка"/>
                <ComboBox x:Name="BrandBox" Margin="0,6,0,0" Height="36" VerticalContentAlignment="Center" ToolTip="Показать автомобили выбранной марки" SelectionChanged="Filter_SelectionChanged"/>
            </StackPanel>
            <StackPanel Width="200" Margin="0,0,12,8">
                <TextBlock Text="Сортировка"/>
                <ComboBox x:Name="SortBox" Margin="0,6,0,0" Height="36" VerticalContentAlignment="Center" ToolTip="Выберите порядок автомобилей" SelectionChanged="Filter_SelectionChanged">
                    <ComboBoxItem Content="Марка и модель А–Я"/>
                    <ComboBoxItem Content="Марка и модель Я–А"/>
                    <ComboBoxItem Content="Сначала дешевле"/>
                    <ComboBoxItem Content="Сначала дороже"/>
                    <ComboBoxItem Content="Сначала новые"/>
                    <ComboBoxItem Content="Сначала старые"/>
                </ComboBox>
            </StackPanel>
            <Button Content="Сбросить" Width="120" Height="36" Margin="0,22,12,8" ToolTip="Очистить поиск и фильтры" Click="ResetButton_Click"/>
        </WrapPanel>
        <DataGrid x:Name="CarsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" RowHeaderWidth="0" MinHeight="120" ToolTip="Выберите автомобиль для редактирования или удаления">
            <DataGrid.Columns>
                <DataGridTextColumn Header="VIN" Binding="{Binding VIN}" Width="165"/>
                <DataGridTextColumn Header="Марка" Binding="{Binding Brand}" Width="120"/>
                <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="130"/>
                <DataGridTextColumn Header="Год" Binding="{Binding Year}" Width="65"/>
                <DataGridTextColumn Header="Цвет" Binding="{Binding Color}" Width="100"/>
                <DataGridTextColumn Header="Пробег, км" Binding="{Binding Kilomitrage, StringFormat=N0}" Width="105"/>
                <DataGridTextColumn Header="Цена, ₽" Binding="{Binding Price, StringFormat=N2}" Width="140"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="CountText" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <WrapPanel>
                <Button x:Name="AddButton" Width="145" Height="42" Margin="0,0,8,8" ToolTip="Добавить автомобиль" Click="AddButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="18" Height="18" Fill="{DynamicResource ButtonTextBrush}" Margin="0,0,8,0"><Rectangle.OpacityMask><ImageBrush ImageSource="/Images/plus.png"/></Rectangle.OpacityMask></Rectangle>
                        <TextBlock Text="Добавить" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="EditButton" Width="165" Height="42" Margin="0,0,8,8" ToolTip="Изменить выбранный автомобиль" Click="EditButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="18" Height="18" Fill="{DynamicResource ButtonTextBrush}" Margin="0,0,8,0"><Rectangle.OpacityMask><ImageBrush ImageSource="/Images/pencil.png"/></Rectangle.OpacityMask></Rectangle>
                        <TextBlock Text="Редактировать" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="DeleteButton" Width="145" Height="42" Margin="0,0,8,8" ToolTip="Удалить выбранный автомобиль" Click="DeleteButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="18" Height="18" Fill="{DynamicResource ButtonTextBrush}" Margin="0,0,8,0"><Rectangle.OpacityMask><ImageBrush ImageSource="/Images/trash.png"/></Rectangle.OpacityMask></Rectangle>
                        <TextBlock Text="Удалить" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BuyButton" Content="Купить" Width="145" Height="42" Margin="0,0,8,8" Visibility="Collapsed" ToolTip="Оформить заявку и зарезервировать выбранный автомобиль" Click="BuyButton_Click"/>
                <Button Content="Обновить" Width="145" Height="42" Margin="0,0,8,8" ToolTip="Загрузить актуальные данные из базы" Click="RefreshButton_Click"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Page>
