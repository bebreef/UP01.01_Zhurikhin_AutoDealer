<Page x:Class="WPF_Zhurikhin_AutoDealer.Pages.EmployeesPage" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      Title="Сотрудники" 
      Loaded="Page_Loaded">
    <Grid x:Name="ContentPanel" Margin="24">
        <Grid x:Name="ListPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Сотрудники" FontSize="26" FontWeight="Bold" Margin="0,0,0,12"/>
            <StackPanel Grid.Row="1">
                <TextBox x:Name="SearchBox" Margin="0,0,0,8" ToolTip="Поиск по ФИО, логину, должности и телефону" TextChanged="SearchBox_TextChanged"/>
                <WrapPanel Margin="0,0,0,12">
                    <ComboBox x:Name="FilterRoleBox" Width="210" Height="36" Margin="0,0,8,0" ToolTip="Фильтр роли" SelectionChanged="Filter_SelectionChanged"/>
                    <ComboBox x:Name="StateBox" Width="150" Height="36" SelectedIndex="0" ToolTip="Фильтр активности" SelectionChanged="Filter_SelectionChanged"><ComboBoxItem Content="Все записи"/><ComboBoxItem Content="Активные"/><ComboBoxItem Content="Отключённые"/></ComboBox>
                </WrapPanel>
            </StackPanel>
            <DataGrid x:Name="EmployeesGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" ToolTip="Выберите сотрудника. Нажмите заголовок столбца для сортировки">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="200"/>
                    <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="120"/>
                    <DataGridTextColumn Header="Роль" Binding="{Binding Roles.RoleName}" Width="180"/>
                    <DataGridTextColumn Header="Должность" Binding="{Binding Position}" Width="180"/>
                    <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="160"/>
                    <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="3">
                <TextBlock x:Name="CountText" Margin="0,10"/>
                <WrapPanel><Button Content="Добавить" Width="120" Click="NewButton_Click"/><Button Content="Редактировать" Width="165" Click="EditButton_Click"/><Button Content="Обновить" Width="120" Click="RefreshButton_Click"/><Button Content="Удалить" Width="110" Click="DeleteButton_Click"/></WrapPanel>
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="EditorPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Left" Width="650">
            <StackPanel>
                <TextBlock x:Name="EditorTitle" Text="Новый сотрудник" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
                <TextBlock Text="ФИО *"/><TextBox x:Name="FullNameBox" MaxLength="150" ToolTip="ФИО сотрудника"/>
                <TextBlock Text="Должность *"/><TextBox x:Name="PositionBox" MaxLength="50" ToolTip="Должность до 50 символов"/>
                <TextBlock Text="Телефон"/><TextBox x:Name="PhoneBox" MaxLength="20" ToolTip="От 10 до 15 цифр, поле необязательное"/>
                <TextBlock Text="Логин *"/><TextBox x:Name="LoginBox" MaxLength="50" ToolTip="Латинские буквы, цифры, точка, дефис, подчёркивание"/>
                <TextBlock Text="Роль *"/><ComboBox x:Name="RoleBox" DisplayMemberPath="RoleName" SelectedValuePath="RoleID" Height="36" Margin="5" ToolTip="Роль определяет права сотрудника"/>
                <CheckBox x:Name="ActiveBox" Content="Учётная запись активна" IsChecked="True" Foreground="{DynamicResource TextBrush}" Margin="5,12"/>
                <TextBlock Text="Новый пароль"/><PasswordBox x:Name="PasswordBox" MaxLength="128" ToolTip="При редактировании оставьте пустым, чтобы сохранить пароль"/>
                <TextBlock Text="Подтверждение пароля"/><PasswordBox x:Name="ConfirmBox" MaxLength="128"/>
                <TextBlock Text="Для новой записи пароль обязателен. Для сохранения прежнего пароля оставьте оба поля пустыми." TextWrapping="Wrap" Margin="5,8"/>
                <WrapPanel><Button Content="Сохранить" Width="160" Click="SaveButton_Click" ToolTip="Сохранить учётную запись"/><Button Content="Отмена" Width="140" Click="CancelButton_Click" ToolTip="Вернуться к списку без сохранения"/></WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
