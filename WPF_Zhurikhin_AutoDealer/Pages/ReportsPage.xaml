<Page x:Class="WPF_Zhurikhin_AutoDealer.Pages.ReportsPage" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      Title="Отчёты" 
      Loaded="Page_Loaded">
    <Grid x:Name="ContentPanel" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Отчёт по продажам" FontSize="26" FontWeight="Bold" Margin="0,0,0,12"/>
        <WrapPanel Grid.Row="1">
            <StackPanel Margin="0,0,12,12"><TextBlock Text="С даты"/><DatePicker x:Name="FromPicker" Width="145" Height="36" Foreground="Black" Background="White" ToolTip="Начало периода включительно"/></StackPanel>
            <StackPanel Margin="0,0,12,12"><TextBlock Text="По дату"/><DatePicker x:Name="ToPicker" Width="145" Height="36" Foreground="Black" Background="White" ToolTip="Конец периода включительно"/></StackPanel>
            <StackPanel Margin="0,0,12,12"><TextBlock Text="Сотрудник"/><ComboBox x:Name="EmployeeBox" DisplayMemberPath="FullName" SelectedValuePath="EmployeeID" Width="240" Height="36" ToolTip="Продажи выбранного сотрудника"/></StackPanel>
            <StackPanel Margin="0,0,12,12"><TextBlock Text="Диаграмма"/><ComboBox x:Name="ChartTypeBox" Width="170" Height="36" SelectedIndex="0" SelectionChanged="ChartType_SelectionChanged"><ComboBoxItem Content="Столбцы"/><ComboBoxItem Content="Линия"/><ComboBoxItem Content="Круговая"/></ComboBox></StackPanel>
            <Button Content="Сформировать" Width="150" Margin="0,18,0,12" Click="GenerateButton_Click" ToolTip="Загрузить исполненные сделки за выбранный период"/>
        </WrapPanel>
        <TextBlock x:Name="SummaryText" Grid.Row="2" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
            <Image x:Name="ChartImage" Stretch="Uniform" Margin="0,0,16,0" ToolTip="Сумма исполненных сделок по месяцам"/>
            <DataGrid x:Name="ReportGrid" Grid.Column="1" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Месяц" Binding="{Binding Month}" Width="85"/>
                    <DataGridTextColumn Header="Продажи" Binding="{Binding Count}" Width="80"/>
                    <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Amount, StringFormat=N2}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <WrapPanel x:Name="ExportPanel" Grid.Row="4" Margin="0,12,0,0" IsEnabled="False">
            <Button Content="Экспорт DOCX" Width="160" Tag="docx" Click="ExportButton_Click" ToolTip="Сохранить отчёт через Microsoft Word"/>
            <Button Content="Экспорт PDF" Width="160" Tag="pdf" Click="ExportButton_Click" ToolTip="Сохранить PDF через Microsoft Word"/>
            <Button Content="Экспорт XLSX" Width="160" Tag="xlsx" Click="ExportButton_Click" ToolTip="Сохранить таблицу и диаграмму через Microsoft Excel"/>
        </WrapPanel>
    </Grid>
</Page>
