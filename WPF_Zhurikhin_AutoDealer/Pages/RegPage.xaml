<Page x:Class="WPF_Zhurikhin_AutoDealer.Pages.RegPage" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      Title="Регистрация">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Border Width="400" Padding="24" CornerRadius="20" BorderThickness="1" BorderBrush="{DynamicResource InputBorderBrush}" Background="{DynamicResource CardBackgroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="АвтоДилер" FontSize="28" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="Регистрация" FontSize="15" TextAlignment="Center" Margin="0,4,0,12" Opacity="0.7"/>
                    <TextBlock Text="ФИО" FontSize="14" Margin="0,12,0,6"/>
                    <TextBox x:Name="FullNameTB" Height="38" Margin="0" FontSize="15" Padding="8,0" VerticalContentAlignment="Center" ToolTip="ФИО" MaxLength="150"/>
                    <TextBlock Text="Должность" FontSize="14" Margin="0,12,0,6"/>
                    <TextBox x:Name="PositionTB" Height="38" Margin="0" FontSize="15" Padding="8,0" VerticalContentAlignment="Center" ToolTip="Должность" MaxLength="50"/>
                    <TextBlock Text="Телефон (необязательно)" FontSize="14" Margin="0,12,0,6"/>
                    <TextBox x:Name="PhoneTB" Height="38" Margin="0" FontSize="15" Padding="8,0" VerticalContentAlignment="Center" ToolTip="Телефон (необязательно)" MaxLength="20"/>
                    <TextBlock Text="Логин" FontSize="14" Margin="0,12,0,6"/>
                    <TextBox x:Name="LoginTB" Height="38" Margin="0" FontSize="15" Padding="8,0" VerticalContentAlignment="Center" ToolTip="Логин" MaxLength="50"/>
                    <TextBlock Text="Пароль" FontSize="14" Margin="0,12,0,6"/>
                    <PasswordBox x:Name="PasswordTB" Height="38" Margin="0" FontSize="15" Padding="8,0" VerticalContentAlignment="Center" ToolTip="Пароль" MaxLength="128"/>
                    <TextBlock Text="Подтверждение пароля" FontSize="14" Margin="0,12,0,6"/>
                    <PasswordBox x:Name="ConfirmPasswordTB" Height="38" Margin="0" FontSize="15" Padding="8,0" VerticalContentAlignment="Center" ToolTip="Подтверждение пароля" MaxLength="128"/>
                    <TextBlock Text="От 6 до 128 символов: латинские буквы и цифры, хотя бы одна цифра." TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" Opacity="0.7"/>
                    <TextBlock Text="Роль" FontSize="14" Margin="0,12,0,6"/>
                    <ComboBox x:Name="RoleCB" Height="38" Padding="8,0" FontSize="15" VerticalContentAlignment="Center" DisplayMemberPath="RoleName" ToolTip="Выберите роль учебной учетной записи" Background="White" Foreground="#202938">
                        <ComboBox.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#202938"/>
                            </Style>
                        </ComboBox.Resources>
                    </ComboBox>
                    <Button x:Name="SaveButton" Content="Зарегистрироваться" Height="42" Margin="0,20,0,0" FontSize="15" FontWeight="SemiBold" Click="SaveButton_Click"/>
                    <Button Content="Вернуться ко входу" Height="42" Margin="0,8,0,0" FontSize="15" Click="BackButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
