<Page x:Class="WPF_Zhurikhin_AutoDealer.Pages.ClientEditPage" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      Title="Клиент" 
      Background="{DynamicResource WindowBackgroundBrush}" 
      Foreground="{DynamicResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="650" HorizontalAlignment="Left" Width="570">
            <TextBlock x:Name="HeadingText" FontSize="26" FontWeight="Bold" Margin="0,0,0,16"/>
            <TextBlock Text="Поля со звёздочкой обязательны." Margin="0,0,0,16"/>
            <TextBlock Text="ФИО *"/>
            <TextBox x:Name="FullNameBox" MaxLength="150" Margin="0,6,0,16" ToolTip="Фамилия, имя и отчество клиента, до 150 символов"/>
            <TextBlock Text="Телефон *"/>
            <TextBox x:Name="PhoneBox" MaxLength="20" Margin="0,6,0,4" ToolTip="От 10 до 15 цифр; допустимы +, пробелы, скобки и дефисы"/>
            <TextBlock Text="Например: +7(900)123-45-67" Opacity="0.7" Margin="0,0,0,16"/>
            <TextBlock Text="Паспорт"/>
            <TextBox x:Name="PassportBox" MaxLength="30" Margin="0,6,0,16" ToolTip="Серия и номер документа, до 30 символов; поле необязательное"/>
            <TextBlock Text="Электронная почта"/>
            <TextBox x:Name="EmailBox" MaxLength="100" Margin="0,6,0,4" ToolTip="Например name@example.com; поле необязательное"/>
            <TextBlock Text="Паспорт и email можно оставить пустыми." Opacity="0.7" Margin="0,0,0,20"/>
            <WrapPanel>
                <Button x:Name="SaveButton" Content="Сохранить" Width="160" Height="42" Margin="0,0,12,8" ToolTip="Проверить данные и сохранить клиента" Click="SaveButton_Click"/>
                <Button Content="Отмена" Width="140" Height="42" Margin="0,0,0,8" ToolTip="Вернуться без сохранения" Click="CancelButton_Click"/>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
