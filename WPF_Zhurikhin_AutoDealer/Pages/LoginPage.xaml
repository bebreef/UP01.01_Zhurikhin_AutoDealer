<Page x:Class="WPF_Zhurikhin_AutoDealer.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF_Zhurikhin_AutoDealer.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Авторизация">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Border Width="360" Padding="24" CornerRadius="20" BorderThickness="1" Background="Gray" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="АвтоДилер" FontSize="28" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="Вход в систему" FontSize="15" TextAlignment="Center" Margin="0,4,0,22" Opacity="0.7"/>

                    <TextBlock Text="Логин" FontSize="14" Margin="0,0,0,6"/>
                    <TextBox x:Name="LoginTB" Height="38" Margin="0" FontSize="15" Padding="8,0" VerticalContentAlignment="Center" ToolTip="Введите свой логин"/>

                    <TextBlock Text="Пароль" FontSize="14" Margin="0,14,0,6"/>
                    <PasswordBox x:Name="PasswordTB" Height="38" Margin="0" FontSize="15" Padding="8,0" VerticalContentAlignment="Center" ToolTip="Введите свой пароль"/>

                    <Grid Margin="0,12,0,0">
                        <Button x:Name="ChangePassword" Content="Сменить пароль" Height="30" Margin="0" Padding="8,0" FontSize="12" HorizontalAlignment="Left" Click="ChangePassword_Click"/>
                        <Button x:Name="RegButton" Content="Регистрация" Height="30" Margin="0" Padding="8,0" FontSize="12" HorizontalAlignment="Right" Click="RegButton_Click"/>
                    </Grid>

                    <StackPanel x:Name="CaptchaGrid" Visibility="Collapsed" Margin="0,18,0,0">
                        <TextBlock Text="Подтвердите, что вы человек" FontSize="13" TextAlignment="Center" Margin="0,0,0,8"/>
                        <Border Background="Gray" CornerRadius="10" Padding="10">
                            <TextBlock x:Name="CaptchaText" FontSize="24" FontWeight="Bold" FontFamily="Consolas" Foreground="#263449" TextAlignment="Center"/>
                        </Border>
                        <TextBox x:Name="CaptchaTB" Height="36" Margin="0,8,0,0" FontSize="15" VerticalContentAlignment="Center" ToolTip="Введите символы с учётом регистра"/>
                        <Button x:Name="CaptchaConfirm" Content="Подтвердить" Height="34" Margin="0,8,0,0" FontSize="13" Click="CaptchaConfirm_Click"/>
                    </StackPanel>

                    <Button x:Name="LoginButton" Content="Войти" Height="42" Margin="0,20,0,0" FontSize="16" FontWeight="SemiBold" Click="LoginButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
