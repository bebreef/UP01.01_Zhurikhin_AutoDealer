<Page x:Class="WPF_Zhurikhin_AutoDealer.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF_Zhurikhin_AutoDealer.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegPage">

    <Grid>
        <Border Width="300" CornerRadius="14" Background="Gray" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="АВТОРИЗАЦИЯ" FontSize="20" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="10"/>
                <TextBlock Text="Логин:" FontSize="14" Margin="5,0,5,0" HorizontalAlignment="Left"/>
                <TextBox x:Name="LoginTB" FontSize="14" Margin="5,0,5,0"/>
                <TextBlock Text="Пароль:" FontSize="14" Margin="5,10,5,0" HorizontalAlignment="Left"/>
                <PasswordBox x:Name="PasswordTB" FontSize="14" Margin="5,0,5,0"/>
                <Grid>
                    <Button Padding="5" Height="25" FontSize="12" Content="Забыли пароль?" Margin="5,10,0,10" HorizontalAlignment="Left" x:Name="ChangePassword" Click="ChangePassword_Click"/>
                    <Button Padding="5" Height="25" FontSize="12" Content="Регистрация" Margin="0,10,5,10" HorizontalAlignment="Right" x:Name="RegButton" Click="RegButton_Click"/>
                </Grid>
                <Grid Margin="5" x:Name="CaptchaGrid" Visibility="Hidden">
                    <TextBlock FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" x:Name="CaptchaText"/>
                    <WrapPanel>
                        <TextBox x:Name="CaptchaTB" FontSize="14" Text="Введите капчу..."/>
                        <Button Margin="5" Content="Подтвердить" x:Name="CaptchaConfirm" Click="CaptchaConfirm_Click"/>
                    </WrapPanel>
                </Grid>
                <Button HorizontalAlignment="Center" VerticalAlignment="Bottom" Content="Войти" FontSize="14" Padding="10" x:Name="LoginButton" Click="LoginButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
