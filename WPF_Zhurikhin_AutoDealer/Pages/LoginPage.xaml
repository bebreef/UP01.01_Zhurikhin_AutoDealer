<Page x:Class="WPF_Zhurikhin_AutoDealer.Pages.LoginPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      Title="Авторизация" 
      FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Border Width="400" Padding="24" CornerRadius="20" BorderThickness="1" BorderBrush="{DynamicResource InputBorderBrush}" Background="{DynamicResource CardBackgroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="АвтоДилер" FontSize="28" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="Вход в систему" FontSize="15" TextAlignment="Center" Margin="0,4,0,12" Opacity="0.7"/>
                    <TextBlock Text="Логин" FontSize="14" Margin="0,12,0,6"/>
                    <TextBox x:Name="LoginTB" Height="38" Margin="0" FontSize="15" Padding="8,0" VerticalContentAlignment="Center" MaxLength="50" ToolTip="Введите свой логин"/>
                    <TextBlock Text="Пароль" FontSize="14" Margin="0,12,0,6"/>
                    <PasswordBox x:Name="PasswordTB" Height="38" Margin="0" FontSize="15" Padding="8,0" VerticalContentAlignment="Center" ToolTip="Введите свой пароль"/>
                    <StackPanel x:Name="CaptchaGrid" Visibility="Collapsed" Margin="0,18,0,0">
                        <TextBlock Text="Подтвердите, что вы человек" FontSize="14" TextAlignment="Center" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                            <TextBlock x:Name="CaptchaText" FontSize="26" FontWeight="Bold" FontFamily="Consolas" TextAlignment="Center"/>
                        </Border>
                        <TextBox x:Name="CaptchaTB" Height="38" Margin="0,8,0,0" FontSize="15" Padding="8,0" VerticalContentAlignment="Center" MaxLength="6" ToolTip="Введите шесть символов с учетом регистра"/>
                        <Button x:Name="CaptchaConfirm" Content="Подтвердить" Height="42" Margin="0,8,0,0" FontSize="15" ToolTip="Проверить введенные символы" Click="CaptchaConfirm_Click"/>
                    </StackPanel>
                    <Button x:Name="LoginButton" Content="Войти" Height="42" Margin="0,20,0,0" FontSize="15" FontWeight="SemiBold" ToolTip="Войти в учетную запись" Click="LoginButton_Click"/>
                    <Button x:Name="RegButton" Content="Регистрация" Height="42" Margin="0,8,0,0" FontSize="15" ToolTip="Создать учетную запись" Click="RegButton_Click"/>
                    <Button x:Name="ChangePassword" Content="Сменить пароль" Height="42" Margin="0,8,0,0" FontSize="15" ToolTip="Изменить пароль с проверкой текущего пароля" Click="ChangePassword_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
