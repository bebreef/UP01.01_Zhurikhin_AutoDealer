<Page x:Class="WPF_Zhurikhin_AutoDealer.Pages.ClientsPage" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      Title="Клиенты" 
      Loaded="Page_Loaded" 
      Background="{DynamicResource WindowBackgroundBrush}" 
      Foreground="{DynamicResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Клиенты" FontSize="26" FontWeight="Bold" Margin="0,0,0,16"/>
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Width="310" Margin="0,0,12,8">
                <TextBlock Text="Поиск по ФИО, телефону, паспорту, email"/>
                <Grid>
                    <TextBox x:Name="SearchBox" Margin="0,6,0,0" MaxLength="100" ToolTip="Введите часть ФИО, телефона, паспорта или email" TextChanged="SearchBox_TextChanged"/>
                    <TextBlock Text="Начните вводить…" Margin="9,6,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.55">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
            <StackPanel Width="190" Margin="0,0,12,8">
                <TextBlock Text="Электронная почта"/>
                <ComboBox x:Name="ContactBox" SelectedIndex="0" Margin="0,6,0,0" Height="36" VerticalContentAlignment="Center" ToolTip="Фильтр по наличию электронной почты" SelectionChanged="Filter_SelectionChanged">
                    <ComboBoxItem Content="Все клиенты"/>
                    <ComboBoxItem Content="С email"/>
                    <ComboBoxItem Content="Без email"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Width="190" Margin="0,0,12,8">
                <TextBlock Text="Сортировка"/>
                <ComboBox x:Name="SortBox" SelectedIndex="0" Margin="0,6,0,0" Height="36" VerticalContentAlignment="Center" ToolTip="Порядок клиентов" SelectionChanged="Filter_SelectionChanged">
                    <ComboBoxItem Content="ФИО А–Я"/>
                    <ComboBoxItem Content="ФИО Я–А"/>
                    <ComboBoxItem Content="Сначала добавленные позже"/>
                </ComboBox>
            </StackPanel>
            <Button Content="Сбросить" Width="120" Height="36" Margin="0,22,12,8" ToolTip="Очистить поиск и фильтры" Click="ResetButton_Click"/>
        </WrapPanel>
        <DataGrid x:Name="ClientsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" RowHeaderWidth="0" MinHeight="120" ToolTip="Выберите клиента для редактирования или удаления">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding ClientID}" Width="55"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="2*" MinWidth="240"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="165"/>
                <DataGridTextColumn Header="Паспорт" Binding="{Binding Passport}" Width="140"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" MinWidth="190"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="CountText" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <WrapPanel>
                <Button x:Name="AddButton" Width="145" Height="42" Margin="0,0,8,8" ToolTip="Добавить клиента" Click="AddButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="18" Height="18" Fill="{DynamicResource ButtonTextBrush}" Margin="0,0,8,0"><Rectangle.OpacityMask><ImageBrush ImageSource="/Images/plus.png"/></Rectangle.OpacityMask></Rectangle>
                        <TextBlock Text="Добавить" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="EditButton" Width="165" Height="42" Margin="0,0,8,8" ToolTip="Изменить выбранного клиента" Click="EditButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="18" Height="18" Fill="{DynamicResource ButtonTextBrush}" Margin="0,0,8,0"><Rectangle.OpacityMask><ImageBrush ImageSource="/Images/pencil.png"/></Rectangle.OpacityMask></Rectangle>
                        <TextBlock Text="Редактировать" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="DeleteButton" Width="145" Height="42" Margin="0,0,8,8" ToolTip="Удалить выбранного клиента" Click="DeleteButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="18" Height="18" Fill="{DynamicResource ButtonTextBrush}" Margin="0,0,8,0"><Rectangle.OpacityMask><ImageBrush ImageSource="/Images/trash.png"/></Rectangle.OpacityMask></Rectangle>
                        <TextBlock Text="Удалить" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Content="Обновить" Width="145" Height="42" Margin="0,0,8,8" ToolTip="Загрузить актуальные данные из базы" Click="RefreshButton_Click"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Page>
