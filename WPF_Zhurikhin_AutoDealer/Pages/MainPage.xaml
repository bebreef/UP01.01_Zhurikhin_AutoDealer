<Page x:Class="WPF_Zhurikhin_AutoDealer.Pages.MainPage" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      Title="Главная" 
      Loaded="Page_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="24">
                <StackPanel>
                    <TextBlock x:Name="WelcomeText" Text="Добро пожаловать" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="RoleText" Margin="0,8,0,0" FontSize="15" Opacity="0.7" TextWrapping="Wrap"/>
                    <TextBlock Text="Подведите мышь к левому краю окна, чтобы открыть меню и выбрать раздел." Margin="0,16,0,0" FontSize="15" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Сведения автодилерского центра" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,12"/>
            <WrapPanel>
                <Border Width="210" Margin="0,0,12,12" Padding="20" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="16">
                    <StackPanel>
                        <TextBlock Text="Автомобили" FontSize="15"/>
                        <TextBlock x:Name="CarsCountText" Text="—" FontSize="32" FontWeight="Bold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Width="210" Margin="0,0,12,12" Padding="20" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="16">
                    <StackPanel>
                        <TextBlock Text="Клиенты" FontSize="15"/>
                        <TextBlock x:Name="ClientsCountText" Text="—" FontSize="32" FontWeight="Bold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Width="210" Margin="0,0,12,12" Padding="20" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="16">
                    <StackPanel>
                        <TextBlock Text="Оформленные сделки" FontSize="15"/>
                        <TextBlock x:Name="DealsCountText" Text="—" FontSize="32" FontWeight="Bold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
            <Button Content="Обновить сведения" Width="210" Height="42" Margin="0,8,0,0" HorizontalAlignment="Left" ToolTip="Загрузить количество записей из базы данных" Click="RefreshButton_Click"/>
            <TextBlock x:Name="StatusText" Margin="0,12,0,0" FontSize="13" Opacity="0.7" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Page>
