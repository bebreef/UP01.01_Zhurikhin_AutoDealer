<Page x:Class="WPF_Zhurikhin_AutoDealer.Pages.ChangePasswordPage" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      Title="Смена пароля">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Border Width="400" Padding="24" CornerRadius="20" BorderThickness="1" BorderBrush="{DynamicResource InputBorderBrush}" Background="{DynamicResource CardBackgroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="АвтоДилер" FontSize="28" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="Смена пароля" FontSize="15" TextAlignment="Center" Margin="0,4,0,12" Opacity="0.7"/>
                    <TextBlock Text="Логин" FontSize="14" Margin="0,12,0,6"/>
                    <TextBox x:Name="LoginTB" Height="38" Margin="0" FontSize="15" Padding="8,0" VerticalContentAlignment="Center" ToolTip="Логин" MaxLength="50"/>
                    <TextBlock Text="Текущий пароль" FontSize="14" Margin="0,12,0,6"/>
                    <PasswordBox x:Name="OldPasswordTB" Height="38" Margin="0" FontSize="15" Padding="8,0" VerticalContentAlignment="Center" ToolTip="Текущий пароль"/>
                    <TextBlock Text="Новый пароль" FontSize="14" Margin="0,12,0,6"/>
                    <PasswordBox x:Name="PasswordTB" Height="38" Margin="0" FontSize="15" Padding="8,0" VerticalContentAlignment="Center" ToolTip="Новый пароль" MaxLength="128"/>
                    <TextBlock Text="Подтверждение нового пароля" FontSize="14" Margin="0,12,0,6"/>
                    <PasswordBox x:Name="ConfirmPasswordTB" Height="38" Margin="0" FontSize="15" Padding="8,0" VerticalContentAlignment="Center" ToolTip="Подтверждение нового пароля" MaxLength="128"/>
                    <TextBlock Text="От 6 до 128 символов: латинские буквы и цифры, хотя бы одна цифра." TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" Opacity="0.7"/>
                    <Button x:Name="SaveButton" Content="Сохранить пароль" Height="42" Margin="0,20,0,0" FontSize="15" FontWeight="SemiBold" Click="SaveButton_Click"/>
                    <Button x:Name="BackButton" Content="Вернуться ко входу" Height="42" Margin="0,8,0,0" FontSize="15" Click="BackButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
